    // Custom message
    this.ctx.fillStyle = this.options.colorTheme === 'dark' ? '#fff' : '#333';
    this.ctx.font = 'italic 20px Arial';
    this.ctx.textAlign = 'center';
    
    // Handle multi-line text
    const words = this.options.customText.split(' ');
    let line = '';
    let lineY = y + 30;
    const maxWidth = this.canvas.width * 0.7;
    
    for (let i = 0; i < words.length; i++) {
        const testLine = line + words[i] + ' ';
        const metrics = this.ctx.measureText(testLine);
        
        if (metrics.width > maxWidth && i > 0) {
            this.ctx.fillText(line, this.canvas.width / 2, lineY);
            line = words[i] + ' ';
            lineY += 25;
        } else {
            line = testLine;
        }
    }
    this.ctx.fillText(line, this.canvas.width / 2, lineY);
    
    // Closing quote
    this.ctx.textAlign = 'right';
    this.ctx.fillStyle = this.options.colorTheme === 'dark' ? 'rgba(255, 255, 255, 0.2)' : 'rgba(0, 0, 0, 0.1)';
    this.ctx.font = 'bold 60px Arial';
    this.ctx.fillText('"', this.canvas.width * 0.85, y + 70);
