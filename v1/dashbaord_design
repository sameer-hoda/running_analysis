### 2. Implement Map Drawing Using Polyline

```javascript
// Add to ActivityImageGenerator
async drawMap() {
    if (!this.activity.map?.summary_polyline) return;
    
    const mapWidth = this.canvas.width * 0.8;
    const mapHeight = mapWidth * 0.6;
    const mapX = (this.canvas.width - mapWidth) / 2;
    const mapY = 400;
    
    // Draw map background
    this.ctx.fillStyle = this.options.colorTheme === 'dark' ? '#3d3d3d' : '#ffffff';
    this.ctx.fillRect(mapX, mapY, mapWidth, mapHeight);
    this.ctx.strokeStyle = '#ddd';
    this.ctx.lineWidth = 2;
    this.ctx.strokeRect(mapX, mapY, mapWidth, mapHeight);
    
    // Decode and draw polyline
    const points = this.decodePolyline(this.activity.map.summary_polyline);
    if (points.length > 0) {
        // Find bounds
        let minLat = points[0][0], maxLat = points[0][0];
        let minLng = points[0][1], maxLng = points[0][1];
        
        points.forEach(point => {
            minLat = Math.min(minLat, point[0]);
            maxLat = Math.max(maxLat, point[0]);
            minLng = Math.min(minLng, point[1]);
            maxLng = Math.max(maxLng, point[1]);
        });
        
        // Draw route
        this.ctx.beginPath();
        points.forEach((point, index) => {
            // Convert geo coordinates to pixel coordinates
            const x = mapX + mapWidth * (point[1] - minLng) / (maxLng - minLng);
            const y = mapY + mapHeight - mapHeight * (point[0] - minLat) / (maxLat - minLat);
            
            if (index === 0) {
                this.ctx.moveTo(x, y);
            } else {
                this.ctx.lineTo(x, y);
            }
        });
        
        // Style route line
        this.ctx.strokeStyle = this.getRouteColor();
        this.ctx.lineWidth = 3;
        this.ctx.stroke();
        
        // Draw start and end points
        this.drawMapMarker(
            mapX + mapWidth * (points[0][1] - minLng) / (maxLng - minLng),
            mapY + mapHeight - mapHeight * (points[0][0] - minLat) / (maxLat - minLat), 
            '#4CAF50'
        );
        this.drawMapMarker(
            mapX + mapWidth * (points[points.length-1][1] - minLng) / (maxLng - minLng),
            mapY + mapHeight - mapHeight * (points[points.length-1][0] - minLat) / (maxLat - minLat), 
            '#F44336'
        );
    }
    
    // Add map attribution
    this.ctx.font = '10px Arial';
    this.ctx.fillStyle = '#999';
    this.ctx.textAlign = 'right';
    this.ctx.fillText('Map data © Strava', mapX + mapWidth - 5, mapY + mapHeight - 5);
}

// Helper method to draw map markers
drawMapMarker(x, y, color) {
    this.ctx.beginPath();
    this.ctx.arc(x, y, 5, 0, Math.PI * 2);
    this.ctx.fillStyle = color;
    this.ctx.fill();
    this.ctx.strokeStyle = '#fff';
    this.ctx.lineWidth = 2;
    this.ctx.stroke();
}

// Helper method to decode Google's encoded polyline format
decodePolyline(encoded) {
    // Add polyline decoding logic here
    // This is a standard algorithm - you can find implementations online
    // Here's a simplified version:
    let points = [];
    let index = 0, lat = 0, lng = 0;
    
    while (index < encoded.length) {
        let b, shift = 0, result = 0;
        do {
            b = encoded.charCodeAt(index++) - 63;
            result |= (b & 0x1f) << shift;
            shift += 5;
        } while (b >= 0x20);
        let dlat = ((result & 1) ? ~(result >> 1) : (result >> 1));
        lat += dlat;
        
        shift = 0;
        result = 0;
        do {
            b = encoded.charCodeAt(index++) - 63;
            result |= (b & 0x1f) << shift;
            shift += 5;
        } while (b >= 0x20);
        let dlng = ((result & 1) ? ~(result >> 1) : (result >> 1));
        lng += dlng;
        
        points.push([lat * 1e-5, lng * 1e-5]);
    }
    
    return points;
}

getRouteColor() {
    switch(this.options.colorTheme) {
        case 'gradient-blue': return '#4e73df';
        case 'gradient-red': return '#e74a3b';
        case 'dark': return '#ff9800';
        default: return '#ff5722';
    }
}
