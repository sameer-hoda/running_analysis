// Modify generateImage to handle different templates
async generateImage() {
    if (!this.ctx || !this.activity || !this.athlete) {
        console.error('Cannot generate image: context, activity, or athlete data is missing.');
        return this.canvas;
    }
    imageLoadingOverlay.style.display = 'flex';
    
    // Clear canvas
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    
    // Select template
    switch(this.options.template) {
        case 'minimal':
            await this.generateMinimalTemplate();
            break;
        case 'detailed':
            await this.generateDetailedTemplate();
            break;
        case 'achievement':
            await this.generateAchievementTemplate();
            break;
        default:
            await this.generateStandardTemplate();
    }
    
    imageLoadingOverlay.style.display = 'none';
    return this.canvas;
}

// Standard template
async generateStandardTemplate() {
    await this.drawBackground();
    await this.drawHeader();
    await this.drawPrimaryMetrics();
    
    if (this.options.includeMap && this.activity.map?.summary_polyline) {
        await this.drawMap();
    }
    
    if (this.options.includeHeartRate && this.activity.has_heartrate) {
        await this.drawHeartRateChart();
    }
    
    if (this.options.includePace) {
        await this.drawPaceChart();
    }
    
    if (this.options.customText) {
        await this.drawCustomText();
    }
    
    await this.drawAthleteInfo();
}

