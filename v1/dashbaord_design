// Add to ActivityImageGenerator
async drawHeartRateChart() {
    if (!this.activity.has_heartrate) return;
    
    const chartWidth = this.canvas.width * 0.4;
    const chartHeight = 120;
    const chartX = this.canvas.width * 0.1;
    const chartY = 650;
    
    // Draw chart background
    this.drawChartBackground(chartX, chartY, chartWidth, chartHeight, 'Heart Rate');
    
    // Since we don't have actual heart rate data points, we'll create a stylized representation
    const avgHR = this.activity.average_heartrate;
    const maxHR = this.activity.max_heartrate;
    
    // Draw the HR zone visualization
    this.ctx.beginPath();
    
    // Draw a stylized HR curve (simulated since we don't have the time series data)
    this.ctx.moveTo(chartX, chartY + chartHeight - 20);
    
    // Create a wave pattern simulating heart rate
    for (let i = 0; i < chartWidth; i += 10) {
        const variance = Math.sin(i/10) * 15;
        const height = chartHeight * 0.6 - variance;
        
        this.ctx.lineTo(chartX + i, chartY + height);
    }
    
    this.ctx.strokeStyle = '#ff5252';
    this.ctx.lineWidth = 3;
    this.ctx.stroke();
    
    // Draw average HR line
    const avgHRY = chartY + chartHeight - (avgHR / maxHR) * chartHeight;
    this.ctx.beginPath();
    this.ctx.moveTo(chartX, avgHRY);
    this.ctx.lineTo(chartX + chartWidth, avgHRY);
    this.ctx.strokeStyle = 'rgba(255, 255, 255, 0.5)';
    this.ctx.lineWidth = 1;
    this.ctx.stroke();
    
    // Display HR values
    this.ctx.fillStyle = '#ff5252';
    this.ctx.font = 'bold 24px Arial';
    this.ctx.textAlign = 'center';
    this.ctx.fillText(`${avgHR} bpm avg`, chartX + chartWidth/2, chartY + chartHeight + 30);
    this.ctx.font = '16px Arial';
    this.ctx.fillText(`Max: ${maxHR} bpm`, chartX + chartWidth/2, chartY + chartHeight + 55);
}

async drawPaceChart() {
    // Similar to heart rate chart but for pace
    const chartWidth = this.canvas.width * 0.4;
    const chartHeight = 120;
    const chartX = this.canvas.width * 0.5;
    const chartY = 650;
    
    // Draw chart background
    this.drawChartBackground(chartX, chartY, chartWidth, chartHeight, 'Pace');
    
    // Calculate pace in min/km from m/s
    const avgPaceMinPerKm = (1000 / this.activity.average_speed) / 60;
    const avgPaceMin = Math.floor(avgPaceMinPerKm);
    const avgPaceSec = Math.round((avgPaceMinPerKm - avgPaceMin) * 60);
    const paceDisplay = `${avgPaceMin}:${avgPaceSec.toString().padStart(2, '0')}`;
    
    // Draw pace visualization (similar style to HR)
    this.ctx.beginPath();
    
    // Stylized line for pace
    for (let i = 0; i < chartWidth; i += 15) {
        const height = chartHeight * 0.3 + Math.random() * chartHeight * 0.4;
        if (i === 0) {
            this.ctx.moveTo(chartX, chartY + height);
        } else {
            this.ctx.lineTo(chartX + i, chartY + height);
        }
    }
    
    this.ctx.strokeStyle = '#4fc3f7';
    this.ctx.lineWidth = 3;
    this.ctx.stroke();
    
    // Display pace value
    this.ctx.fillStyle = '#4fc3f7';
    this.ctx.font = 'bold 24px Arial';
    this.ctx.textAlign = 'center';
    this.ctx.fillText(`${paceDisplay} /km`, chartX + chartWidth/2, chartY + chartHeight + 30);
}

// Helper to draw chart background
drawChartBackground(x, y, width, height, title) {
    // Draw container with rounded corners
    this.ctx.fillStyle = this.options.colorTheme === 'dark' ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.05)';
    this.roundRect(x, y, width, height, 10);
    
    // Draw title
    this.ctx.fillStyle = this.options.colorTheme === 'dark' ? '#fff' : '#333';
    this.ctx.font = '14px Arial';
    this.ctx.textAlign = 'left';
    this.ctx.fillText(title, x + 10, y - 10);
    
    // Draw grid lines
    this.ctx.strokeStyle = this.options.colorTheme === 'dark' ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)';
    this.ctx.lineWidth = 1;
    
    // Horizontal grid lines
    for (let i = 0; i < height; i += height / 4) {
        this.ctx.beginPath();
        this.ctx.moveTo(x, y + i);
        this.ctx.lineTo(x + width, y + i);
        this.ctx.stroke();
    }
}

// Helper for rounded rectangles
roundRect(x, y, width, height, radius) {
    this.ctx.beginPath();
    this.ctx.moveTo(x + radius, y);
    this.ctx.lineTo(x + width - radius, y);
    this.ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
    this.ctx.lineTo(x + width, y + height - radius);
    this.ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
    this.ctx.lineTo(x + radius, y + height);
    this.ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
    this.ctx.lineTo(x, y + radius);
    this.ctx.quadraticCurveTo(x, y, x + radius, y);
    this.ctx.closePath();
    this.ctx.fill();
}
