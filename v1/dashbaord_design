// Replace drawPrimaryMetrics method with a more modern card-based approach
async drawPrimaryMetrics() {
    const metricsY = 220;
    const cardWidth = this.canvas.width * 0.4;
    const cardHeight = 100;
    const spacing = 20;
    
    // Draw distance card
    const distanceKm = (this.activity.distance / 1000).toFixed(2);
    this.drawMetricCard(this.canvas.width / 2 - cardWidth - spacing/2, metricsY, 
                      cardWidth, cardHeight, 'DISTANCE', `${distanceKm} km`, '📏');
    
    // Draw time card
    const movingTime = new Date(this.activity.moving_time * 1000).toISOString().substr(11, 8);
    this.drawMetricCard(this.canvas.width / 2 + spacing/2, metricsY, 
                      cardWidth, cardHeight, 'TIME', movingTime, '⏱️');
    
    // Draw elevation card if available
    if (this.activity.total_elevation_gain) {
        this.drawMetricCard(this.canvas.width / 2 - cardWidth - spacing/2, metricsY + cardHeight + spacing, 
                          cardWidth, cardHeight, 'ELEVATION', `${this.activity.total_elevation_gain.toFixed(0)} m`, '⛰️');
    }
    
    // Draw pace/speed card
    if (this.activity.type === 'Run' && this.activity.average_speed) {
        const paceMinPerKm = (1000 / this.activity.average_speed) / 60;
        const paceMinutes = Math.floor(paceMinPerKm);
        const paceSeconds = Math.round((paceMinPerKm - paceMinutes) * 60);
        this.drawMetricCard(this.canvas.width / 2 + spacing/2, metricsY + cardHeight + spacing, 
                          cardWidth, cardHeight, 'AVG PACE', 
                          `${paceMinutes}:${paceSeconds.toString().padStart(2, '0')} /km`, '🏎️');
    } else if (this.activity.average_speed) {
        const speedKmh = (this.activity.average_speed * 3.6).toFixed(1);
        this.drawMetricCard(this.canvas.width / 2 + spacing/2, metricsY + cardHeight + spacing, 
                          cardWidth, cardHeight, 'AVG SPEED', `${speedKmh} km/h`, '🏎️');
    }
}

// Helper to draw metric cards
drawMetricCard(x, y, width, height, label, value, icon) {
    // Card background
    this.ctx.fillStyle = this.options.colorTheme === 'dark' ? 'rgba(255, 255, 255, 0.1)' : 'rgba(255, 255, 255, 0.8)';
    this.roundRect(x, y, width, height, 10);
    
    // Icon
    this.ctx.font = '24px Arial';
    this.ctx.textAlign = 'left';
    this.ctx.fillText(icon, x + 15, y + 35);
    
    // Label
    this.ctx.fillStyle = this.options.colorTheme === 'dark' ? 'rgba(255, 255, 255, 0.7)' : 'rgba(0, 0, 0, 0.6)';
    this.ctx.font = '14px Arial';
    this.ctx.fillText(label, x + 50, y + 25);
    
    // Value
    this.ctx.fillStyle = this.options.colorTheme === 'dark' ? '#fff' : '#000';
    this.ctx.font = 'bold 28px Arial';
    this.ctx.fillText(value, x + 50, y + 60);
}
