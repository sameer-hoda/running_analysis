# Copy to .env and fill in. Never commit the real file.
# Gemini audit (required for scoring)
GEMINI_API_KEY=your_gemini_key_here
# Tripo v3 cloud 3D (required for personal rebuilds; without it jobs use the
# studio stand-in mesh so the full report UX stays clickable)
TRIPO_API_KEY=your_tripo_key_here
TRIPO_MODEL=v3.1-20260211
# fast (default): standard texture+geometry, 50k faces, ~90s builds, 1-2MB files
# best: PBR + detailed + Ultra + align_image, 100k faces, ~130s builds, 4-5MB
TRIPO_QUALITY=fast
TRIPO_FACE_LIMIT=50000
# Coach voice (optional; silent tour + captions if empty)
INWORLD_API_KEY=
INWORLD_TTS_VOICE=Nate
