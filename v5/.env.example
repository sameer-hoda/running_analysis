# mynextpr v5 — local Strava credentials (TEMPLATE, no real values here).
# Copy to .env and fill in locally: cp .env.example .env
# Never commit .env. Never paste real tokens into chat or screenshots.

# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Must match the redirect URI in your Strava app settings exactly
STRAVA_REDIRECT_URI=http://localhost:5001/exchange_token

# App server port
PORT=5001

# Requested OAuth scopes for the countdown bot (do not edit unless you know why)
# read = webhook minimum; activity:write = update own activities
STRAVA_SCOPES=read,activity:write
